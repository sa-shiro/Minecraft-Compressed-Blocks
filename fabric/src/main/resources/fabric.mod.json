{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "${source}",
    "issues": "${source}/issues",
    "curseforge": "${curseforge_page}",
    "modrinth": "${modrinth_page}",
    "homepage": "${homepage}",
    "email": "${mod_author_email}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/${logo_file}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sashiro.compressedblocks.fabric.CompressedBlocksFabric"
    ],
    "client": [
      "net.sashiro.compressedblocks.fabric.client.CBFabricClient"
    ],
    "fabric-datagen": [
      "net.sashiro.compressedblocks.fabric.data.CBFabricDataGenerator"
    ],
    "modmenu": [
      "net.sashiro.compressedblocks.fabric.client.CBModMenuApiImpl"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_mc_version_range}",
    "java": ">=${java_version}",
    "forgeconfigapiport": "*"
  },
  "suggests": {},
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "${curseforge_page}",
        "modmenu.modrinth": "${modrinth_page}",
        "modmenu.discord": "${discord}"
      },
      "update_checker": true
    }
  }
}
  